# Copy to server/.env and fill in. Never commit the real file.
# (Builder B's cli.ts also reads a repo-root .env, so either location works locally.)

# --- LLM provider for Builder B's pipeline ---
# 'zai' (GLM, default — cheap) or 'anthropic'. See server/brain/llm.ts.
LLM_PROVIDER=zai
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
MODEL_SMART=glm-5.3-flash
MODEL_FAST=glm-5.3-flash
# GLM always thinks; 'low' keeps a world spawn ~50s instead of ~220s.
GLM_EFFORT=low
# Only read when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# --- Builder B knobs ---
# Set to 1 to replay captured fixtures instead of calling the API.
BRAIN_MOCK=0
# Scanned PDFs are OCR'd through server/brain/ocr.py (~4s/page, cached by hash). 0 disables.
BRAIN_OCR=1
# Headless-browser fallback for JS-rendered URLs (server/brain/scrape.py). Off unless 1.
BRAIN_BROWSER_FALLBACK=0
# Path to the python that has requirements.txt installed. Default: server/brain/.venv
# BRAIN_PYTHON=

# --- Server (Builder C) ---
PORT=3001
# 'zen' puts Builder B's brain in front; any call that throws or times out falls back
# to the built-in brain. Unset = built-in brain only (sample worlds, rule-based grading).
BRAIN=zen
# Seconds to wait for world generation before falling back to the sample world,
# which the teacher console then labels "Sample world — not generated by the AI".
# A scanned worksheet on GLM takes ~100s once OCR is cached; 240 leaves headroom.
SPAWN_TIMEOUT_SECONDS=240
