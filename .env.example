# Copy to server/.env and fill in. Never commit the real file.

# Required — Builder B's pipeline and Builder C's server both read this
ANTHROPIC_API_KEY=sk-ant-...

# Server
PORT=3001

# Set to 1 to replay captured LLM fixtures instead of calling the API.
# Use this during integration so you don't burn tokens or block on the network.
BRAIN_MOCK=0

# Seconds to wait for world generation before falling back to fallbackWorld.json
SPAWN_TIMEOUT_SECONDS=90
